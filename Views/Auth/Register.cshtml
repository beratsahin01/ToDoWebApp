@{
    Layout = null;
    ViewData["Title"] = "Kayıt Ol";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - To Do Panel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <!-- Ana Tasarım Dosyamız -->
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>

    <div class="auth-wrapper">
        <div class="auth-box">
            <div class="text-center mb-4">
                <div class="auth-logo"><i class="fas fa-feather-alt"></i></div>
                <h4 class="fw-bold mb-1" style="color: var(--text-main);">Hesap Oluştur</h4>
                <p class="text-muted" style="font-size: 0.9rem;">Hemen ücretsiz hesabınızı oluşturun.</p>
            </div>

            <!-- Hata Mesajı Alanı -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger bg-danger bg-opacity-25 border-danger border-opacity-50 text-white rounded-3 p-2 mb-3 text-center" style="font-size: 0.9rem;">
                    <i class="fas fa-exclamation-circle me-1"></i> @ViewBag.Error
                </div>
            }

            <form action="/Auth/Register" method="post">
                @Html.AntiForgeryToken()
                <!-- Ad Soyad Input -->
                <div class="mb-3">
                    <label class="form-label text-muted" style="font-size: 0.85rem; font-weight: 600;">Kullanıcı Adı veya Adınız</label>
                    <input type="text" name="username" class="form-control" placeholder="Örn: Ali Yılmaz" required autocomplete="username" />
                </div>

                <!-- Email Input -->
                <div class="mb-3">
                    <label class="form-label text-muted" style="font-size: 0.85rem; font-weight: 600;">E-Posta Adresi</label>
                    <input type="email" name="email" class="form-control" placeholder="ornek@mail.com" required autocomplete="email" />
                </div>

                <!-- Şifre Input -->
                <div class="mb-4">
                    <label class="form-label text-muted" style="font-size: 0.85rem; font-weight: 600;">Şifre</label>
                    <input type="password" name="password" class="form-control" placeholder="En az 6 karakter" required autocomplete="new-password" />
                </div>

                <button type="submit" class="btn-new-task w-100 justify-content-center mb-4" style="padding: 12px;">
                    Kayıt Ol <i class="fas fa-user-plus ms-2"></i>
                </button>
            </form>

            <div class="text-center text-muted" style="font-size: 0.9rem;">
                Zaten hesabınız var mı? <a href="/Auth/Login" class="custom-link fw-bold">Giriş Yapın</a>
            </div>
        </div>
    </div>

</body>
</html>