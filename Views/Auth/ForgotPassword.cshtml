@{
    Layout = null;
    ViewData["Title"] = "Şifremi Unuttum";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ToDo</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>

    <div class="auth-wrapper">
        <div class="auth-box">
            <div class="text-center mb-4">
                <div class="auth-logo"><i class="fas fa-feather-alt"></i></div>
                <h4 class="fw-bold mb-1" style="color: var(--text-main);">Şifremi Unuttum</h4>
                <p class="text-muted" style="font-size: 0.9rem;">E-posta adresinizi girin, size şifrenizi sıfırlamanız için bir bağlantı gönderelim.</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger rounded-3 p-2 mb-3 text-center fw-bold" style="font-size: 0.9rem;">
                    <i class="fas fa-exclamation-circle me-1"></i> @ViewBag.Error
                </div>
            }

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success bg-success bg-opacity-10 border-success border-opacity-25 text-success rounded-3 p-2 mb-3 text-center fw-bold" style="font-size: 0.9rem;">
                    <i class="fas fa-check-circle me-1"></i> @ViewBag.Success
                </div>
            }

            <form action="/Auth/ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-4">
                    <label class="form-label text-muted" style="font-size: 0.85rem; font-weight: 600;">E-Posta Adresi</label>
                    <input type="email" name="Email" class="form-control" placeholder="ornek@mail.com" required autocomplete="email" />
                </div>

                <button type="submit" class="btn-new-task w-100 justify-content-center mb-4" style="padding: 12px;">
                    Bağlantı Gönder <i class="fas fa-paper-plane ms-2"></i>
                </button>
            </form>

            <div class="text-center">
                <a href="/Auth/Login" class="custom-link" style="font-size: 0.9rem;">
                    <i class="fas fa-arrow-left me-1"></i> Giriş Ekranına Dön
                </a>
            </div>
        </div>
    </div>

</body>
</html>